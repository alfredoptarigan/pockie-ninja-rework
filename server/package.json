{
  "name": "@pockie/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node24 --clean",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:setup": "tsx --env-file-if-exists=../.env scripts/setup-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env scripts/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=../.env scripts/reset.ts",
    "db:seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
    "db:seed-qa": "tsx --env-file-if-exists=../.env scripts/seed-qa.ts",
    "create-admin": "tsx --env-file-if-exists=../.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@pockie/game-core": "workspace:*",
    "@pockie/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "obscenity": "^0.4.6",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
