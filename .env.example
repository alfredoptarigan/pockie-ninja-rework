# Copy to .env and adjust. Every setting has a production-safe meaning.
NODE_ENV=development
HOST=127.0.0.1
# API port. Not PORT, so tools that inject PORT for the web client do not collide.
API_PORT=3000
# Origin of the web client. State-changing requests from any other Origin are rejected.
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://localhost:5432/pockie_remastered
TEST_DATABASE_URL=postgres://localhost:5432/pockie_remastered_test
