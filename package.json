{
  "name": "pockie-ninja-remastered",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pockie/client --filter @pockie/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:coverage": "pnpm -r test:coverage",
    "e2e": "playwright test",
    "db:setup": "pnpm --filter @pockie/server db:setup",
    "db:generate": "pnpm --filter @pockie/server db:generate",
    "db:migrate": "pnpm --filter @pockie/server db:migrate",
    "db:reset": "pnpm --filter @pockie/server db:reset",
    "db:seed": "pnpm --filter @pockie/server db:seed",
    "create-admin": "pnpm --filter @pockie/server create-admin",
    "assets:export": "node tools/export-assets.ts",
    "reborn:fetch": "tools/fetch-reborn-data.sh",
    "i18n:extract": "node tools/i18n/extract-source.ts",
    "i18n:candidates": "node tools/i18n/build-glossary-candidates.ts",
    "i18n:names": "node tools/i18n/names.ts",
    "game-data:import": "node tools/game-data/import.ts",
    "i18n:sentences": "node tools/i18n/sentences.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
